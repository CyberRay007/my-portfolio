        <mxCell id="bQ9Dz2FVQqVBsyvt8Nis-53" edge="1" parent="1" source="bQ9Dz2FVQqVBsyvt8Nis-30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#c62828;endArrow=block;fontSize=11;fontColor=#c62828;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="bQ9Dz2FVQqVBsyvt8Nis-31" value="Instant alerts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bQ9Dz2FVQqVBsyvt8Nis-54" edge="1" parent="1" source="bQ9Dz2FVQqVBsyvt8Nis-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;endArrow=block;fontSize=11;fontColor=#2e7d32;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="bQ9Dz2FVQqVBsyvt8Nis-5" value="Internet only">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bQ9Dz2FVQqVBsyvt8Nis-55" edge="1" parent="1" source="bQ9Dz2FVQqVBsyvt8Nis-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#c62828;endArrow=cross;fontSize=11;fontColor=#c62828;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" target="bQ9Dz2FVQqVBsyvt8Nis-7" value="BLOCKED – no access to internal files">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bQ9Dz2FVQqVBsyvt8Nis-56" parent="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#f9a825;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;SECURITY ANNOTATIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt; &lt;b&gt;1. External Firewall&lt;/b&gt; – first barrier. Blocks generic internet threats; allows only HTTPS to the WAF and VPN traffic to the gateway.&lt;br&gt;&lt;br&gt; &lt;b&gt;2. WAF&lt;/b&gt; – OWASP protection: blocks injection/XSS payloads, rate-limits login attempts (brute force).&lt;br&gt;&lt;br&gt; &lt;b&gt;3. IDS/IPS&lt;/b&gt; – real-time detection and blocking on both firewall boundaries; alerts go to SIEM.&lt;br&gt;&lt;br&gt; &lt;b&gt;4. Web Server (DMZ)&lt;/b&gt; – moved out of the internal network; TLS only; shows generic error messages to the public.&lt;br&gt;&lt;br&gt; &lt;b&gt;5. Internal Firewall&lt;/b&gt; – second barrier. Only approved web-to-app traffic passes inward; the DMZ cannot reach the database.&lt;br&gt;&lt;br&gt; &lt;b&gt;6. App Servers&lt;/b&gt; – input validation and sanitization; detailed errors go only to the secure internal log, never to users.&lt;br&gt;&lt;br&gt; &lt;b&gt;7. IAM + MFA&lt;/b&gt; – passwords 12–14+ chars, common-password blocklist, MFA, least privilege, auto-logout after 15 min inactivity with one-time-code re-verification.&lt;br&gt;&lt;br&gt; &lt;b&gt;8. Database zone&lt;/b&gt; – 3 layers (external FW, internal FW, DB firewall). AES-256 encryption at rest, TLS in transit, access limited to authorized systems/people.&lt;br&gt;&lt;br&gt; &lt;b&gt;9. VPN Gateway&lt;/b&gt; – mandatory encrypted tunnel for remote staff; laptops run approved software only.&lt;br&gt;&lt;br&gt; &lt;b&gt;10. Segmentation&lt;/b&gt; – HR, Marketing and IT VLANs cannot exchange files without approval; guest Wi-Fi is internet-only.&lt;br&gt;&lt;br&gt; &lt;b&gt;11. SIEM + XDR&lt;/b&gt; – logs from all zones, continuous threat hunting, instant alerts to the IT team.&lt;br&gt;&lt;br&gt; &lt;b&gt;12. DevSecOps&lt;/b&gt; – automated code scanning on every commit, secure coding training, continuous security testing." vertex="1">
          <mxGeometry height="830" width="400" x="840" y="70" as="geometry" />
        </mxCell>
